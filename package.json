{
  "name": "moe-counter-cf",
  "version": "1.0.0",
  "private": true,
  "description": "Moe-Counter-Go 迁移到 Cloudflare Workers + D1 的 TypeScript 版",
  "scripts": {
    "manifest": "node scripts/build-manifest.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 execute moe-counter --remote --file=schema.sql",
    "db:migrate": "bash scripts/migrate-data.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
